@startuml
title Hình E.1 - Sequence đăng ký, OTP và đăng nhập 2FA
actor "Người dùng" as User
participant "React Client" as UI
participant "Auth Controller" as Controller
participant "Auth Service" as Service
database "PostgreSQL" as DB
participant "Mail Service" as Mail
User -> UI : Nhập thông tin đăng ký
UI -> Controller : POST /auth/register
Controller -> Service : validate và register
Service -> DB : Kiểm tra email, tạo user
Service -> DB : Lưu OTP xác minh
Service -> Mail : Gửi OTP
Mail --> User : Email OTP
Controller --> UI : Yêu cầu xác minh
User -> UI : Nhập OTP
UI -> Controller : POST /auth/verify-email
Controller -> Service : Xác minh OTP
Service -> DB : Kiểm tra mã, hạn và số lần thử
Service -> DB : Đánh dấu email đã xác minh
Controller --> UI : Xác minh thành công
User -> UI : Đăng nhập
UI -> Controller : POST /auth/login
Controller -> Service : Kiểm tra tài khoản/mật khẩu
Service -> DB : Đọc cấu hình 2FA
alt 2FA được bật
  Service -> DB : Tạo OTP đăng nhập
  Service -> Mail : Gửi OTP đăng nhập
  Controller --> UI : requiresTwoFactor=true
  User -> UI : Nhập OTP đăng nhập
  UI -> Controller : POST /auth/verify-login-otp
  Controller -> Service : Xác minh OTP
end
Service -> DB : Tạo user_session
Service --> Controller : Access token + refresh token
Controller --> UI : Đăng nhập thành công
@enduml
