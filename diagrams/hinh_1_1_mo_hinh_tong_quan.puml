@startuml
title Hình 1.1 - Mô hình tổng quan nền tảng mua bán xe cũ
left to right direction
actor "Người mua" as Buyer
actor "Người bán" as Seller
actor "Quản trị viên" as Admin
rectangle "NỀN TẢNG MUA BÁN XE CŨ" as Platform {
  component "Tìm kiếm và lọc xe" as Search
  component "Quản lý tin đăng" as Listing
  component "Nhắn tin thời gian thực" as Chat
  component "Xác minh và đánh giá" as Trust
  component "Kiểm duyệt và báo cáo" as Moderation
  component "Thanh toán dịch vụ" as Payment
}
Buyer --> Search : Tìm xe phù hợp
Buyer --> Chat : Trao đổi với người bán
Buyer --> Trust : Xem/ghi đánh giá
Buyer --> Moderation : Báo cáo vi phạm
Seller --> Listing : Tạo và quản lý tin
Seller --> Chat : Tư vấn người mua
Seller --> Trust : Xác minh danh tính/cửa hàng
Seller --> Payment : Thanh toán phí/gói/đẩy tin
Admin --> Moderation : Duyệt tin, xử lý báo cáo
Admin --> Trust : Duyệt xác minh
Admin --> Payment : Quản lý giao dịch, doanh thu
Listing --> Search : Cung cấp dữ liệu xe
Trust --> Search : Bổ sung độ tin cậy
@enduml
