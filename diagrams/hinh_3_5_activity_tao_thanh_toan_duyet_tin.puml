@startuml
title Hình 3.5 - Activity tạo, thanh toán và duyệt tin
start
:Người bán chọn danh mục;
:Nhập thông tin xe và địa chỉ;
:Tải hình ảnh;
if (Sử dụng AI hỗ trợ?) then (Có)
  :Phân tích ảnh;
  :Gợi ý thuộc tính, mô tả, giá;
  :Người bán kiểm tra và chỉnh sửa;
endif
:Kiểm tra dữ liệu biểu mẫu;
if (Dữ liệu hợp lệ?) then (Không)
  :Hiển thị lỗi và yêu cầu bổ sung;
  stop
else (Có)
  :Xem trước chi phí;
endif
if (Phải thanh toán?) then (Có)
  :Chọn phương thức thanh toán;
  if (Thanh toán thành công?) then (Không)
    :Giữ đơn chờ hoặc báo thất bại;
    stop
  else (Có)
    :Xác nhận đơn và kích hoạt quyền đăng;
  endif
endif
:Tạo tin trạng thái chờ duyệt;
:Nhân viên mở chi tiết tin;
if (Tin đạt yêu cầu?) then (Có)
  :Cập nhật trạng thái hoạt động;
  :Gửi thông báo phê duyệt;
else (Không)
  :Nhập lý do từ chối;
  :Cập nhật trạng thái bị từ chối;
  :Gửi thông báo cho người bán;
endif
stop
@enduml
