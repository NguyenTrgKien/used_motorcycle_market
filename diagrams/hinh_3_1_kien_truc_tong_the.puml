@startuml
title Hình 3.1 - Kiến trúc tổng thể hệ thống
skinparam componentStyle rectangle
actor "Người dùng" as User
node "Trình duyệt" {
  component "React 19 + TypeScript" as React
  component "React Router" as Router
  component "TanStack Query + Axios" as ClientData
  component "Socket.IO Client" as SocketClient
}
node "Application Server" {
  component "NestJS REST API" as API
  component "Guards + JWT + Passport" as Auth
  component "Business Modules" as Modules
  component "Socket.IO Gateway" as Gateway
  component "TypeORM" as ORM
}
database "PostgreSQL" as DB
database "Redis" as Redis
cloud "Cloudinary" as Cloudinary
cloud "Email/SendGrid" as Mail
cloud "Google OAuth" as Google
cloud "Gemini API" as Gemini
cloud "VNPay / MoMo" as PayGateway
User --> React
React --> Router
React --> ClientData
React --> SocketClient
ClientData --> API : HTTPS/JSON
SocketClient <--> Gateway : WebSocket
API --> Auth
Auth --> Modules
API --> Modules
Modules --> ORM
ORM --> DB
Modules --> Redis
Modules --> Cloudinary
Modules --> Mail
Auth --> Google
Modules --> Gemini
Modules --> PayGateway
@enduml
