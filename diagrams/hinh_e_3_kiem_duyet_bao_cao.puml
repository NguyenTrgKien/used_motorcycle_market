@startuml
title Hình E.3 - Quy trình kiểm duyệt tin và xử lý báo cáo
start
fork
  :Tin mới ở trạng thái chờ duyệt;
  :CSKH/Admin mở chi tiết tin;
  :Kiểm tra nội dung, hình ảnh, người bán;
  if (Tin hợp lệ?) then (Có)
    :Phê duyệt và công khai tin;
    :Thông báo cho người bán;
  else (Không)
    :Nhập lý do từ chối;
    :Thông báo yêu cầu chỉnh sửa;
  endif
fork again
  :Người dùng gửi báo cáo;
  :Hệ thống lưu trạng thái chờ xử lý;
  :CSKH xem đối tượng và bằng chứng;
  :Chuyển trạng thái đang xử lý;
  if (Có vi phạm?) then (Có)
    if (Đối tượng là tin?) then (Có)
      :Ẩn hoặc xóa tin;
    else (Tài khoản)
      :Cảnh báo hoặc khóa tài khoản;
    endif
    :Ghi kết quả xử lý;
  else (Không)
    :Đóng báo cáo không vi phạm;
  endif
  :Thông báo trạng thái cho người báo cáo;
end fork
stop
@enduml
